[gd_resource type="Resource" script_class="QuestGiverProfile" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_giver_profile.gd" id="1_profile"]
[ext_resource type="Resource" path="res://data/quests/first_salvage.tres" id="2_first_salvage"]
[ext_resource type="Resource" path="res://data/quests/first_scavenger_hunt.tres" id="3_first_scavenger"]
