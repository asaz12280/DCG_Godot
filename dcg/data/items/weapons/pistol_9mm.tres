[resource]
script = ExtResource("1_item_def")
id = &"pistol_9mm"
catalog_number = 5
display_name = "手槍-S"
name_key = &"item.pistol_9mm.name"
description_key = &"item.pistol_9mm.desc"
item_type = "weapon"
weight = 1.1
value = 120
authoring_notes_zh_tw = "手槍-S 數值調整區：damage=單發基礎傷害。fire_rate_per_second=每秒可射幾發，左鍵長按自動連射會使用。weapon_armor_penetration_level=穿甲值，會先抵消防禦力，再用剩餘防禦扣傷害。critical_chance=爆擊率，5 代表 5%，100 代表必定爆擊；爆擊成功造成 2 倍傷害。projectile_pierce_chance=穿透機率，100 代表命中敵人後必定繼續飛，可再打到後方敵人。magazine_capacity=基礎彈匣容量，加長彈匣-S 會再增加容量。reload_duration_seconds=裝填時間，單位秒。projectile_range=子彈有效距離，100 代表 1m，所以 2800 代表 28m。weapon_vertical_recoil=上下後座角度，15 代表準心上下隨機 +-15 度。weapon_horizontal_recoil=左右後座角度，15 代表準心左右隨機 +-15 度。weapon_durability_wear_per_shot=每發消耗耐久。max_durability=新武器耐久上限；已受損或帶回基地的實例會保存自己的目前/上限耐久。compatible_ammo_tags=S 代表小型槍枝專用彈藥。tags 裡的 S 方便搜尋小型槍枝/小型彈藥分類。"
damage = 24
fire_rate_per_second = 1.0
weapon_armor_penetration_level = 1.0
critical_chance = 25.0
projectile_pierce_chance = 25.0
magazine_capacity = 8
reload_duration_seconds = 0.8
projectile_range = 500.0
weapon_horizontal_recoil = 5.0
max_durability = 100
repair_max_durability_loss = 5
compatible_ammo_tags = Array[StringName]([&"S"])
weapon_attachment_slots = Array[StringName]([&"magazine", &"grip", &"muzzle", &"scope", &"stock", &"tactic"])
weapon_profile = SubResource("Resource_weapon_profile_pistol_9mm")
tags = Array[StringName]([&"gun", &"pistol", &"S"])
